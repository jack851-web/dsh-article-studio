{
  "name": "数据简报",
  "description": "报告蓝 #0F4C81 + 琥珀点缀，深底反白表头，为数据密集型内容设计：日报、榜单、模型对比",
  "colors": {
    "primary": "#1F2937",
    "accent": "#0F4C81",
    "background": "#ffffff",
    "blockquote_bg": "#F1F5F9",
    "code_bg": "#F8FAFC",
    "hr_color": "#0F4C81",
    "footnote_bg": "#F8FAFC"
  },
  "styles": {
    "wrapper": {
      "background_color": "#fafafa",
      "padding": "16px"
    },
    "h1": {
      "font_size": "24px",
      "font_weight": "800",
      "color": "#ededed",
      "text_align": "left",
      "background": "#274a69",
      "border_left": "6px solid #8b734b",
      "border_radius": "4px",
      "padding": "14px 18px",
      "margin_top": "24px",
      "margin_bottom": "16px",
      "line_height": "1.3",
      "letter_spacing": "1px"
    },
    "h2": {
      "display": "flex",
      "align_items": "center",
      "border_bottom": "3px solid #324a5e",
      "padding": "0 0 8px 0",
      "margin": "36px 0 14px",
      "line_height": "1.3"
    },
    "h2_prefix": {
      "display": "inline-block",
      "background": "#866632",
      "color": "#f2f2f2",
      "font_size": "14px",
      "font_weight": "800",
      "padding": "2px 8px",
      "border_radius": "4px",
      "margin_right": "10px",
      "letter_spacing": "1px",
      "line_height": "1.5"
    },
    "h2_inner": {
      "display": "inline-block",
      "font_size": "20px",
      "font_weight": "bold",
      "color": "#191b1f",
      "letter_spacing": "0.5px"
    },
    "h3": {
      "font_size": "17px",
      "font_weight": "bold",
      "color": "#41494f",
      "border_left": "4px solid #a68a5a",
      "padding": "0 0 0 10px",
      "margin_top": "28px",
      "margin_bottom": "10px",
      "line_height": "1.3"
    },
    "h4": {
      "font_size": "16px",
      "font_weight": "bold",
      "color": "#33445b",
      "padding": "0",
      "margin_top": "24px",
      "margin_bottom": "8px",
      "line_height": "1.3"
    },
    "h5": {
      "font_size": "15px",
      "font_weight": "bold",
      "color": "#3d424b",
      "padding": "0",
      "margin_top": "20px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "h6": {
      "font_size": "15px",
      "font_weight": "bold",
      "color": "#4a4f59",
      "padding": "0",
      "margin_top": "16px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "p": {
      "font_size": "16px",
      "color": "#353940",
      "line_height": "1.78",
      "margin_top": "0",
      "margin_bottom": "20px",
      "letter_spacing": "0.5px",
      "text_align": "justify"
    },
    "blockquote": {
      "border_left": "4px solid #324a5e",
      "background": "#dee6ed",
      "padding": "14px 16px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "border_radius": "0 6px 6px 0",
      "font_size": "15px",
      "color": "#3d434b",
      "line_height": "1.75"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#3d434b",
      "line_height": "1.75",
      "margin_bottom": "0",
      "letter_spacing": "0.3px",
      "font_style": "normal",
      "background": "transparent"
    },
    "strong": {
      "font_weight": "bold",
      "color": "#41494f"
    },
    "em": {
      "font_style": "normal",
      "font_weight": "bold",
      "color": "#5a5149"
    },
    "a": {
      "color": "#254a6b",
      "text_decoration": "none",
      "border_bottom": "1px solid rgba(50, 74, 94, 0.3)"
    },
    "img": {
      "max_width": "100%",
      "border_radius": "6px",
      "display": "block",
      "box_shadow": "0 2px 10px rgba(65, 73, 79, 0.1)"
    },
    "img_wrapper": {
      "background": "#fafafa",
      "border_radius": "8px",
      "padding": "2px",
      "margin_top": "12px",
      "margin_bottom": "12px"
    },
    "hr": {
      "margin_top": "32px",
      "margin_bottom": "32px",
      "height": "2px",
      "background": "linear-gradient(to right, #324a5e, #8b734b)",
      "border": "none"
    },
    "code": {
      "background": "rgba(39, 74, 105, 0.08)",
      "padding": "3px 6px",
      "border_radius": "4px",
      "font_size": "90%",
      "color": "#5a6c7c",
      "font_family": "Menlo, Monaco, Consolas, 'Courier New', monospace"
    },
    "code_block": {
      "background": "#dee5ed",
      "border_radius": "6px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "overflow": "hidden",
      "border": "1px solid #dee4ed",
      "border_top": "3px solid #324a5e"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "#f2f3f5"
    },
    "pre": {
      "background": "#dee5ed",
      "color": "#30425f",
      "padding": "20px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "14px",
      "line_height": "1.6",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#30425f",
      "font_size": "14px",
      "font_family": "Menlo, Monaco, Consolas, 'Courier New', monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "margin_top": "16px",
      "margin_bottom": "20px",
      "font_size": "14px",
      "border_spacing": "0",
      "border_radius": "6px",
      "overflow": "hidden",
      "border": "1px solid #dee4ed"
    },
    "th": {
      "background": "#274a69",
      "padding": "10px 12px",
      "border": "none",
      "text_align": "left",
      "font_weight": "bold",
      "color": "#ededed",
      "letter_spacing": "0.5px"
    },
    "td": {
      "padding": "9px 12px",
      "border_bottom": "1px solid #dee5ed",
      "color": "#353940"
    },
    "list_item_bullet": {
      "color": "#766a56",
      "margin_right": "8px",
      "font_weight": "bold"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "#274a69",
      "color": "#ededed",
      "border_radius": "4px",
      "font_size": "13px",
      "font_weight": "bold",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#353940",
      "line_height": "1.78",
      "letter_spacing": "0.5px"
    },
    "list_wrapper": {
      "margin_top": "15px",
      "margin_bottom": "15px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "8px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "32px",
      "padding_top": "16px",
      "border_top": "2px solid #324a5e"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "bold",
      "color": "#49505a",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "13px",
      "color": "#49505a",
      "margin_bottom": "6px",
      "line_height": "1.6",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#254a6b",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(39, 74, 105, 0.06)",
      "border_left": "4px solid #324a5e",
      "padding": "16px",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "border_radius": "0 6px 6px 0"
    },
    "callout_title": {
      "font_weight": "bold",
      "color": "#41494f",
      "margin_bottom": "8px",
      "font_size": "15px"
    },
    "callout_content": {
      "font_size": "14px",
      "color": "#3d434b",
      "line_height": "1.75",
      "letter_spacing": "0.3px"
    }
  },
  "decor": {
    "h2": {
      "prefix_text": "{n}"
    }
  },
  "dark_mode": {
    "wrapper": {
      "bgcolor": "#16181d"
    },
    "h1": {
      "bgcolor": "#244261",
      "color": "#ededed"
    },
    "h2_inner": {
      "color": "#e5e7eb"
    },
    "h2_prefix": {
      "bgcolor": "#8a5933",
      "color": "#ededed"
    },
    "h3": {
      "color": "#c0c7ce"
    },
    "blockquote": {
      "bgcolor": "rgba(250, 250, 250, 0.05)"
    },
    "code_block": {
      "bgcolor": "#1e1e1e"
    },
    "code_header": {
      "bgcolor": "#171717"
    },
    "pre": {
      "bgcolor": "#1e1e1e",
      "color": "#d4d4d4"
    },
    "pre_code": {
      "color": "#d4d4d4"
    },
    "code": {
      "bgcolor": "#262626",
      "color": "#89b2d6"
    },
    "img_wrapper": {
      "bgcolor": "#262626"
    },
    "th": {
      "bgcolor": "#244261"
    },
    "callout": {
      "bgcolor": "rgba(39, 74, 105, 0.18)"
    },
    "ol_item_bullet": {
      "bgcolor": "#244261"
    }
  }
}
