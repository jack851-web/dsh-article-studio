{
  "name": "大序号·静蓝",
  "description": "大序号标注章节+清爽蓝色强调，适合结构清晰的教程、指南类文章",
  "colors": {
    "primary": "#333333",
    "accent": "#2563eb",
    "background": "#ffffff",
    "blockquote_bg": "rgba(37,99,235,0.03)",
    "code_bg": "#1e293b",
    "hr_color": "#2563eb",
    "footnote_bg": "rgba(37,99,235,0.03)"
  },
  "layout": "hero",
  "hero": {
    "accent": "#2563eb",
    "accent_light": "#60a5fa",
    "accent_bg": "rgba(37,99,235,0.03)",
    "accent_border": "#bfdbfe",
    "dark_bg": "#1e293b",
    "alt_bg": "#f8fafc",
    "text_color": "#333333",
    "heading_color": "#1a1a1a",
    "number_color": "rgba(37,99,235,0.1)",
    "dark_header": false,
    "dark_footer": false,
    "numbered": true,
    "pull_quotes": false,
    "alt_bg_enabled": false,
    "cards": false,
    "flex_table": true
  },
  "styles": {
    "wrapper": {
      "background_color": "#fafafa",
      "padding": "0"
    },
    "h1": {
      "font_size": "24px",
      "font_weight": "800",
      "color": "#1a1a1a",
      "text_align": "center",
      "padding": "16px 28px",
      "margin_top": "0",
      "margin_bottom": "12px",
      "line_height": "1.35"
    },
    "h2": {
      "font_size": "20px",
      "font_weight": "700",
      "color": "#1a1a1a",
      "padding": "0",
      "margin_top": "0",
      "margin_bottom": "16px",
      "line_height": "1.3"
    },
    "h3": {
      "font_size": "17px",
      "font_weight": "700",
      "color": "#1a1a1a",
      "padding": "0",
      "margin_top": "24px",
      "margin_bottom": "10px",
      "line_height": "1.3"
    },
    "h4": {
      "font_size": "16px",
      "font_weight": "700",
      "color": "#333333",
      "padding": "0",
      "margin_top": "20px",
      "margin_bottom": "8px",
      "line_height": "1.3"
    },
    "h5": {
      "font_size": "15px",
      "font_weight": "600",
      "color": "#525252",
      "padding": "0",
      "margin_top": "18px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "h6": {
      "font_size": "14px",
      "font_weight": "600",
      "color": "#525252",
      "padding": "0",
      "margin_top": "16px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "p": {
      "font_size": "16px",
      "color": "#333333",
      "line_height": "2",
      "margin_top": "0",
      "margin_bottom": "18px",
      "letter_spacing": "0.2px",
      "text_align": "justify"
    },
    "blockquote": {
      "border_left": "3px solid #4b5f8b",
      "background": "rgba(61, 93, 164, 0.03)",
      "padding": "14px 18px",
      "margin_top": "18px",
      "margin_bottom": "18px",
      "border_radius": "0 10px 10px 0",
      "font_size": "15px",
      "color": "#676f84",
      "line_height": "1.7",
      "font_style": "italic"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#494e5a",
      "line_height": "1.7",
      "margin_bottom": "0",
      "font_style": "normal",
      "background": "transparent"
    },
    "strong": {
      "font_weight": "600",
      "color": "#494f5a"
    },
    "em": {
      "font_style": "italic",
      "color": "#505053"
    },
    "a": {
      "color": "#3a5ca6",
      "text_decoration": "none"
    },
    "img": {
      "max_width": "100%",
      "border_radius": "10px",
      "display": "block"
    },
    "img_wrapper": {
      "background": "#fafafa",
      "border_radius": "12px",
      "padding": "4px",
      "margin_top": "10px",
      "margin_bottom": "10px"
    },
    "hr": {
      "margin_top": "28px",
      "margin_bottom": "28px",
      "height": "1px",
      "background": "#dee4ed",
      "border": "none"
    },
    "code": {
      "background": "rgba(61, 93, 164, 0.08)",
      "padding": "3px 6px",
      "border_radius": "5px",
      "font_size": "90%",
      "color": "#5a637c",
      "font_family": "Menlo, Monaco, Consolas, monospace"
    },
    "code_block": {
      "background": "#1f242e",
      "border_radius": "10px",
      "margin_top": "20px",
      "margin_bottom": "20px",
      "overflow": "hidden"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "#243661"
    },
    "pre": {
      "background": "#1f242e",
      "color": "#b5c4d9",
      "padding": "20px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "14px",
      "line_height": "1.5",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#4c6b94",
      "font_size": "14px",
      "font_family": "Menlo, Monaco, Consolas, monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "font_size": "14px",
      "border_spacing": "0",
      "border_radius": "10px",
      "overflow": "hidden",
      "border": "1px solid #e2e4e9"
    },
    "th": {
      "background": "rgba(61, 93, 164, 0.06)",
      "padding": "10px 14px",
      "border": "1px solid #5d6679",
      "text_align": "left",
      "font_weight": "600",
      "color": "#5e6579"
    },
    "td": {
      "padding": "10px 14px",
      "border": "1px solid #e2e4e9",
      "color": "#333333"
    },
    "list_item_bullet": {
      "color": "#3a5ca6",
      "margin_right": "8px",
      "font_weight": "bold"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(61, 93, 164, 0.1)",
      "color": "#5a657c",
      "border_radius": "50%",
      "font_size": "13px",
      "font_weight": "600",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#333333",
      "line_height": "2",
      "letter_spacing": "0.2px"
    },
    "list_wrapper": {
      "margin_top": "15px",
      "margin_bottom": "15px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "8px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "28px",
      "padding_top": "16px",
      "border_top": "1px solid #e2e4e9"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "600",
      "color": "#525252",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "13px",
      "color": "#525252",
      "margin_bottom": "6px",
      "line_height": "1.6",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#3a5ca6",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(61, 93, 164, 0.03)",
      "border_left": "3px solid #4b5f8b",
      "padding": "14px 18px",
      "margin_top": "18px",
      "margin_bottom": "18px",
      "border_radius": "0 10px 10px 0"
    },
    "callout_title": {
      "font_weight": "600",
      "color": "#494e5a",
      "margin_bottom": "8px",
      "font_size": "15px"
    },
    "callout_content": {
      "font_size": "15px",
      "color": "#494e5a",
      "line_height": "1.7"
    }
  }
}
