{
  "name": "微信原生",
  "description": "微信绿 #07c160 原生风格，适合官方/正式/通用内容",
  "colors": {
    "primary": "#333333",
    "accent": "#07c160",
    "background": "#ffffff",
    "blockquote_bg": "rgba(7,193,96,0.06)",
    "code_bg": "#f0f7f2",
    "hr_color": "#07c160",
    "footnote_bg": "rgba(7,193,96,0.04)"
  },
  "styles": {
    "wrapper": {
      "background_color": "#fafafa",
      "padding": "16px"
    },
    "h1": {
      "font_size": "26px",
      "font_weight": "700",
      "color": "#556d61",
      "line_height": "1.32",
      "margin_top": "36px",
      "margin_bottom": "18px",
      "letter_spacing": "-0.015em",
      "padding": "12px 16px 11px",
      "border_left": "5px solid #468263",
      "border_radius": "12px",
      "background": "linear-gradient(180deg, rgba(54, 146, 98, 0.08) 0%, rgba(54, 146, 98, 0.03) 100%)",
      "border_bottom": "1px dashed rgba(29, 53, 41, 0.2)",
      "box_shadow": "0 6px 14px rgba(192, 206, 199, 0.05)"
    },
    "h2": {
      "font_size": "22px",
      "font_weight": "700",
      "color": "#556d63",
      "line_height": "1.4",
      "margin_top": "34px",
      "margin_bottom": "18px",
      "padding": "10px 14px",
      "border_left": "4px solid #468263",
      "border_radius": "12px",
      "background": "linear-gradient(90deg, rgba(54, 146, 98, 0.12) 0%, rgba(54, 146, 98, 0.03) 70%, rgba(54, 146, 98, 0) 100%)"
    },
    "h3": {
      "font_size": "21px",
      "font_weight": "600",
      "color": "#29332e",
      "line_height": "1.45",
      "margin_top": "28px",
      "margin_bottom": "14px",
      "padding_left": "12px",
      "border_left": "3px solid rgba(70, 130, 99, 0.9)",
      "padding": "0 0 6px 12px"
    },
    "p": {
      "font_size": "16px",
      "color": "#333333",
      "line_height": "1.75",
      "margin_top": "0",
      "margin_bottom": "18px",
      "letter_spacing": "0.3px",
      "text_align": "justify"
    },
    "blockquote": {
      "border_left": "4px solid #468263",
      "background": "linear-gradient(135deg, rgba(54, 146, 98, 0.06) 0%, rgba(54, 146, 98, 0.03) 100%)",
      "padding": "16px 20px",
      "border_radius": "12px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "font_size": "15px",
      "color": "#556d61",
      "line_height": "1.75"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#333333",
      "line_height": "1.75",
      "margin_bottom": "0",
      "letter_spacing": "0.02em",
      "background": "transparent"
    },
    "strong": {
      "font_weight": "700",
      "color": "#5e796d",
      "background": "linear-gradient(180deg, rgba(96, 199, 146, 0) 0%, rgba(96, 199, 146, 0) 58%, rgba(96, 199, 146, 0.16) 58%, rgba(96, 199, 146, 0.16) 100%)",
      "padding": "0 3px"
    },
    "em": {
      "font_style": "italic",
      "color": "#525252"
    },
    "a": {
      "color": "#4b6859",
      "text_decoration": "none"
    },
    "img": {
      "max_width": "100%",
      "border_radius": "8px",
      "display": "block",
      "box_shadow": "0 4px 12px rgba(20, 20, 20, 0.08)"
    },
    "img_wrapper": {
      "background": "#fafafa",
      "border_radius": "10px",
      "padding": "4px",
      "margin_top": "10px",
      "margin_bottom": "10px"
    },
    "hr": {
      "margin_top": "36px",
      "margin_bottom": "36px",
      "height": "2px",
      "width": "62%",
      "background": "linear-gradient(90deg, rgba(70, 130, 99, 0) 0%, rgba(70, 130, 99, 0.22) 20%, rgba(70, 130, 99, 0.68) 50%, rgba(70, 130, 99, 0.22) 80%, rgba(70, 130, 99, 0) 100%)",
      "border": "none"
    },
    "code": {
      "background": "rgba(54, 146, 98, 0.06)",
      "padding": "3px 6px",
      "border_radius": "4px",
      "font_size": "90%",
      "color": "#517060",
      "font_family": "Menlo, Monaco, Consolas, 'Courier New', monospace"
    },
    "code_block": {
      "background": "#f2f5f3",
      "border_radius": "8px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "overflow": "hidden"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "rgba(54, 146, 98, 0.15)"
    },
    "pre": {
      "background": "#f2f5f3",
      "color": "#4b6859",
      "padding": "20px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "14px",
      "line_height": "1.5",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#4b6859",
      "font_size": "14px",
      "font_family": "Menlo, Monaco, Consolas, 'Courier New', monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "font_size": "15px",
      "border_spacing": "0",
      "border_radius": "8px",
      "overflow": "hidden"
    },
    "th": {
      "background": "rgba(54, 146, 98, 0.04)",
      "padding": "12px 16px",
      "text_align": "left",
      "font_weight": "600",
      "color": "#6b6b6b",
      "border": "1px solid #4f875d"
    },
    "td": {
      "padding": "12px 16px",
      "border": "1px solid #d8e8dc",
      "color": "#333333"
    },
    "list_item_bullet": {
      "color": "#4b6859",
      "margin_right": "8px",
      "font_weight": "bold"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(54, 146, 98, 0.1)",
      "color": "#517060",
      "border_radius": "50%",
      "font_size": "13px",
      "font_weight": "bold",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#333333",
      "line_height": "1.75",
      "letter_spacing": "0.5px"
    },
    "list_wrapper": {
      "margin_top": "15px",
      "margin_bottom": "15px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "8px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "32px",
      "padding_top": "16px",
      "border_top": "1px dashed #e5e5e5"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "bold",
      "color": "#525252",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "13px",
      "color": "#525252",
      "margin_bottom": "6px",
      "line_height": "1.6",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#4b6859",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(54, 146, 98, 0.08)",
      "border_left": "4px solid #468263",
      "padding": "16px",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "border_radius": "0 12px 12px 0"
    },
    "callout_title": {
      "font_weight": "bold",
      "color": "#495a51",
      "margin_bottom": "8px",
      "font_size": "15px"
    },
    "callout_content": {
      "font_size": "14px",
      "color": "#333333",
      "line_height": "1.8",
      "letter_spacing": "0.3px"
    },
    "h4": {
      "font_size": "20px",
      "font_weight": "bold",
      "color": "#305f46",
      "border_left": "2px solid #468263",
      "padding": "0 0 0 8px",
      "margin_top": "24px",
      "margin_bottom": "8px",
      "line_height": "1.3"
    },
    "h5": {
      "font_size": "19px",
      "font_weight": "bold",
      "color": "#525252",
      "padding": "0",
      "margin_top": "20px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "h6": {
      "font_size": "15px",
      "font_weight": "bold",
      "color": "#525252",
      "padding": "0",
      "margin_top": "16px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    }
  },
  "dark_mode": {
    "wrapper": {
      "bgcolor": "#1e1e1e"
    },
    "h1": {
      "color": "#c0cec7"
    },
    "h2": {
      "color": "#c0cec7"
    },
    "code_block": {
      "bgcolor": "#1e1e1e"
    },
    "code_header": {
      "bgcolor": "#171717"
    },
    "pre": {
      "bgcolor": "#1e1e1e",
      "color": "#d4d4d4"
    },
    "pre_code": {
      "color": "#d4d4d4"
    },
    "code": {
      "bgcolor": "#262626",
      "color": "#d4d4d4"
    },
    "blockquote": {
      "bgcolor": "rgba(250, 250, 250, 0.05)"
    },
    "img_wrapper": {
      "bgcolor": "#262626"
    },
    "th": {
      "bgcolor": "#262626"
    },
    "callout": {
      "bgcolor": "rgba(54, 146, 98, 0.12)"
    },
    "ol_item_bullet": {
      "bgcolor": "rgba(54, 146, 98, 0.2)"
    }
  }
}
