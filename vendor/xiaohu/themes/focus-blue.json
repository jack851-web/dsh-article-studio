{
  "name": "聚焦·蓝",
  "description": "聚焦蓝 #4B6EF5 居中标题+上下线，适合品牌/展示/营销内容",
  "colors": {
    "primary": "#2c2c2c",
    "accent": "#4B6EF5",
    "background": "#ffffff",
    "blockquote_bg": "rgba(75,110,245,0.05)",
    "code_bg": "#282c34",
    "hr_color": "#4B6EF5",
    "footnote_bg": "rgba(75,110,245,0.04)"
  },
  "styles": {
    "wrapper": {
      "background_color": "#fafafa",
      "padding": "16px"
    },
    "h1": {
      "font_size": "26px",
      "font_weight": "700",
      "color": "#494d5a",
      "text_align": "center",
      "padding": "16px 0",
      "line_height": "1.4",
      "margin_top": "0",
      "margin_bottom": "28px",
      "background_image": "linear-gradient(rgba(182, 189, 216, 0.35), rgba(182, 189, 216, 0.35)), linear-gradient(rgba(182, 189, 216, 0.35), rgba(182, 189, 216, 0.35))",
      "background_size": "100% 1px, 100% 1px",
      "background_position": "center top, center bottom",
      "background_repeat": "no-repeat"
    },
    "h2": {
      "font_size": "22px",
      "font_weight": "700",
      "color": "#494d5a",
      "text_align": "center",
      "padding": "12px 0",
      "line_height": "1.35",
      "margin_top": "36px",
      "margin_bottom": "24px",
      "background_image": "linear-gradient(rgba(182, 189, 216, 0.3), rgba(182, 189, 216, 0.3)), linear-gradient(rgba(182, 189, 216, 0.3), rgba(182, 189, 216, 0.3))",
      "background_size": "80% 1px, 80% 1px",
      "background_position": "center top, center bottom",
      "background_repeat": "no-repeat"
    },
    "h3": {
      "font_size": "20px",
      "font_weight": "600",
      "color": "#494d5a",
      "text_align": "center",
      "padding": "10px 0",
      "line_height": "1.4",
      "margin_top": "28px",
      "margin_bottom": "20px",
      "background_image": "linear-gradient(rgba(182, 189, 216, 0.25), rgba(182, 189, 216, 0.25)), linear-gradient(rgba(182, 189, 216, 0.25), rgba(182, 189, 216, 0.25))",
      "background_size": "70% 1px, 70% 1px",
      "background_position": "center top, center bottom",
      "background_repeat": "no-repeat"
    },
    "p": {
      "font_size": "16px",
      "color": "#2c2c2c",
      "line_height": "1.75",
      "margin_top": "0",
      "margin_bottom": "20px",
      "letter_spacing": "0.3px",
      "text_align": "justify"
    },
    "blockquote": {
      "border_left": "5px solid #848fbc",
      "background_color": "rgba(182, 189, 216, 0.05)",
      "padding": "16px 8px 1px 8px",
      "margin_top": "4px",
      "margin_bottom": "20px",
      "font_style": "italic",
      "line_height": "1.7"
    },
    "blockquote_p": {
      "font_size": "15px",
      "color": "#525252",
      "line_height": "1.75",
      "margin_bottom": "0",
      "letter_spacing": "0.02em"
    },
    "strong": {
      "font_weight": "700",
      "color": "#494d5a"
    },
    "em": {
      "font_style": "italic",
      "color": "#525252"
    },
    "a": {
      "color": "#3a51a6",
      "text_decoration": "none"
    },
    "img": {
      "max_width": "100%",
      "border_radius": "8px",
      "display": "block",
      "box_shadow": "0 4px 12px rgba(20, 20, 20, 0.08)"
    },
    "img_wrapper": {
      "background": "#fafafa",
      "border_radius": "10px",
      "padding": "4px",
      "margin_top": "10px",
      "margin_bottom": "10px"
    },
    "hr": {
      "margin_top": "32px",
      "margin_bottom": "32px",
      "height": "3px",
      "width": "60%",
      "background": "#848fbc",
      "border": "none"
    },
    "code": {
      "background": "rgba(182, 189, 216, 0.1)",
      "padding": "2px 6px",
      "border_radius": "4px",
      "font_size": "90%",
      "color": "#3a51a6",
      "font_family": "Menlo, Monaco, Consolas, 'Courier New', monospace"
    },
    "code_block": {
      "background": "#21252b",
      "border_radius": "8px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "overflow": "hidden",
      "box_shadow": "0 2px 10px rgba(199, 199, 199, 0.15)"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "36px",
      "padding": "0 12px",
      "background": "#1e1e1e"
    },
    "pre": {
      "background": "#21252b",
      "color": "#d4d4d4",
      "padding": "20px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "14px",
      "line_height": "1.5",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#525252",
      "font_size": "14px",
      "font_family": "Menlo, Monaco, Consolas, 'Courier New', monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "separate",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "font_size": "15px",
      "border_spacing": "0",
      "border_radius": "8px",
      "overflow": "hidden"
    },
    "th": {
      "background": "#b6bdd8",
      "padding": "12px 16px",
      "text_align": "center",
      "font_weight": "600",
      "color": "#484848",
      "border": "1px solid rgba(132, 143, 188, 0.2)"
    },
    "td": {
      "padding": "12px 16px",
      "border": "1px solid rgba(132, 143, 188, 0.15)",
      "color": "#333333"
    },
    "list_item_bullet": {
      "color": "#3a51a6",
      "margin_right": "8px",
      "font_weight": "bold"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(182, 189, 216, 0.1)",
      "color": "#3a51a6",
      "border_radius": "50%",
      "font_size": "13px",
      "font_weight": "bold",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#2c2c2c",
      "line_height": 1.75,
      "letter_spacing": "0.5px"
    },
    "list_wrapper": {
      "margin_top": "15px",
      "margin_bottom": "15px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "8px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "32px",
      "padding_top": "16px",
      "border_top": "1px dashed #e5e5e5"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "bold",
      "color": "#525252",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "13px",
      "color": "#525252",
      "margin_bottom": "6px",
      "line_height": "1.6",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#3a51a6",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(182, 189, 216, 0.08)",
      "border_left": "4px solid #848fbc",
      "padding": "16px",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "border_radius": "0 12px 12px 0"
    },
    "callout_title": {
      "font_weight": "bold",
      "color": "#494d5a",
      "margin_bottom": "8px",
      "font_size": "15px"
    },
    "callout_content": {
      "font_size": "14px",
      "color": "#333333",
      "line_height": "1.8",
      "letter_spacing": "0.3px"
    },
    "h4": {
      "font_size": "19px",
      "font_weight": "bold",
      "color": "#3a51a6",
      "border_left": "2px solid #848fbc",
      "padding": "0 0 0 8px",
      "margin_top": "24px",
      "margin_bottom": "8px",
      "line_height": "1.3"
    },
    "h5": {
      "font_size": "18px",
      "font_weight": "bold",
      "color": "#525252",
      "padding": "0",
      "margin_top": "20px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    },
    "h6": {
      "font_size": "15px",
      "font_weight": "bold",
      "color": "#525252",
      "padding": "0",
      "margin_top": "16px",
      "margin_bottom": "6px",
      "line_height": "1.3"
    }
  },
  "dark_mode": {
    "wrapper": {
      "bgcolor": "#1e1e1e"
    },
    "h1": {
      "color": "#c0c3ce"
    },
    "h2": {
      "color": "#c0c3ce"
    },
    "code_block": {
      "bgcolor": "#1e1e1e"
    },
    "code_header": {
      "bgcolor": "#171717"
    },
    "pre": {
      "bgcolor": "#1e1e1e",
      "color": "#d4d4d4"
    },
    "pre_code": {
      "color": "#d4d4d4"
    },
    "code": {
      "bgcolor": "#262626",
      "color": "#d4d4d4"
    },
    "blockquote": {
      "bgcolor": "rgba(250, 250, 250, 0.05)"
    },
    "img_wrapper": {
      "bgcolor": "#262626"
    },
    "th": {
      "bgcolor": "#b6bdd8"
    },
    "callout": {
      "bgcolor": "rgba(182, 189, 216, 0.12)"
    },
    "ol_item_bullet": {
      "bgcolor": "rgba(182, 189, 216, 0.2)"
    }
  }
}
