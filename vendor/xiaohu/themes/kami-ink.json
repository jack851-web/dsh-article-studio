{
  "name": "纸墨",
  "description": "Kami 纸系·墨蓝。宋体衬线+极浅暖白底+墨蓝 #27548A 点缀，加粗渐变下划高亮、❖ 装饰分隔。沉稳专业，适合深度解读、研报、严肃长文",
  "colors": {
    "primary": "#1F2A33",
    "accent": "#27548A",
    "background": "#FCFBF9",
    "blockquote_bg": "#F1F5FA",
    "code_bg": "#EEF2F7",
    "hr_color": "#27548A",
    "footnote_bg": "#FCFBF9"
  },
  "styles": {
    "wrapper": {
