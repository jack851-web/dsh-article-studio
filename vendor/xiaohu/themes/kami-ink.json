      "font_size": "27px",
      "font_weight": "700",
      "color": "#49515a",
      "text_align": "center",
      "line_height": "1.45",
      "letter_spacing": "1px",
      "padding": "0 0 14px",
      "border_bottom": "2px solid #3e5673",
      "margin_top": "34px",
      "margin_bottom": "24px",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    },
    "h2": {
      "font_size": "20px",
      "font_weight": "700",
