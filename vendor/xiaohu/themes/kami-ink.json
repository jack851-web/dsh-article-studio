      "margin_bottom": "22px",
      "overflow": "hidden",
      "border": "1px solid #e6e3da"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "3px",
      "padding": "0",
      "background": "#305581"
    },
    "pre": {
