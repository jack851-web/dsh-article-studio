      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "#dee6ed",
      "color": "#2e5583",
      "border_radius": "50%",
      "font_size": "13px",
      "font_weight": "bold",
      "margin_right": "10px",
      "margin_top": "4px"
    },
    "list_item_text": {
      "font_size": "16px",
      "color": "#25292d",
      "line_height": "1.85",
      "letter_spacing": "0.3px",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    },
    "list_wrapper": {
      "margin_top": "18px",
      "margin_bottom": "18px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "9px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "32px",
      "padding_top": "16px",
      "border_top": "1px solid #e6e3da"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "bold",
      "color": "#56534d",
      "margin_bottom": "12px",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    },
    "footnote_item": {
      "font_size": "13px",
      "color": "#56534d",
      "margin_bottom": "6px",
      "line_height": "1.6",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#2e5583",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "#dee5ed",
      "border_left": "4px solid #3e5673",
      "padding": "14px 16px",
      "margin_top": "16px",
      "margin_bottom": "16px",
      "border_radius": "0 6px 6px 0"
    },
    "callout_title": {
      "font_weight": "700",
      "color": "#49515a",
      "margin_bottom": "8px",
      "font_size": "15px",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    },
    "callout_content": {
      "font_size": "14px",
      "color": "#25292d",
      "line_height": "1.78",
      "letter_spacing": "0.2px",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    }
