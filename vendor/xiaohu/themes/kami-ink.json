    "hr": {
      "margin_top": "34px",
      "margin_bottom": "34px",
      "border": "none",
      "text_align": "center",
      "color": "#49515a",
      "font_size": "15px",
      "letter_spacing": "10px",
      "content": "❖ ❖ ❖"
    },
    "code": {
      "background": "#f0f2f4",
      "padding": "2px 6px",
      "border_radius": "3px",
      "font_size": "14px",
      "color": "#2e5583",
      "font_family": "'SF Mono', Consolas, Menlo, monospace"
    },
    "code_block": {
      "background": "#f0f2f4",
      "border_radius": "8px",
