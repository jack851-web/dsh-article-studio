      "color": "#35495a",
      "padding": "18px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "13.5px",
      "line_height": "1.6",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#35495a",
      "font_size": "13.5px",
      "font_family": "'SF Mono', Consolas, Menlo, monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "collapse",
      "margin_top": "22px",
      "margin_bottom": "22px",
      "font_size": "15px",
      "overflow": "hidden",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    },
    "th": {
      "background": "#dee5ed",
      "padding": "10px 13px",
      "border_bottom": "2px solid #3e5673",
      "text_align": "left",
      "font_weight": "700",
      "color": "#25292d",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
