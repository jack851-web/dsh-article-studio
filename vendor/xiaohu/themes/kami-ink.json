      "margin_bottom": "8px",
      "line_height": "1.5",
      "font_family": "'Songti SC','Source Han Serif SC','Noto Serif CJK SC','STSong',Georgia,serif"
    },
    "h5": {
      "font_size": "15px",
      "font_weight": "600",
      "color": "#25292d",
      "margin_top": "18px",
